APP_NAME=SAAP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=saap_local
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
# 12h, não os 120min padrão do Laravel — regra de domínio 7 do CLAUDE.md:
# marco exige 30-60min de observação antes de qualquer salvamento, e
# "nada de sessão única ou expiração". Um valor curto expira a sessão NO
# MEIO da aplicação de um nível, sem o psicólogo tocar em nada — e o
# 419 que isso gera não se resolve sozinho (ver fila-salvamento.js).
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Resumo de avaliação gerado por IA (Google AI Studio / Gemini).
# Modelo fixado, não o alias "-latest": o texto vai para os responsáveis e
# entra no prontuário, então trocar de modelo tem de ser decisão, não um
# alias que se moveu sozinho de madrugada. Sem chave, o recurso some da
# tela — o PDF continua saindo normalmente.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
